# =============================================================================
# CloudSense — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (cloudsense-backend)
# -----------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cloudsense

# JWT
JWT_SECRET=<strong_random_secret>
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=<your_google_client_id>.apps.googleusercontent.com

# Platform AWS credentials (for STS AssumeRole)
AWS_ACCESS_KEY_ID=<your_platform_aws_access_key>
AWS_SECRET_ACCESS_KEY=<your_platform_aws_secret_key>

# Twilio
TWILIO_ACCOUNT_SID=<your_twilio_sid>
TWILIO_AUTH_TOKEN=<your_twilio_auth_token>
TWILIO_PHONE_NUMBER=<your_twilio_number>

# AI API (use OpenRouter as primary)
OPENROUTER_API_KEY=<your_openrouter_key>
OPENROUTER_MODEL=anthropic/claude-3-haiku

# App URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Monitoring & alerts
ALERT_CONFIDENCE_THRESHOLD=0.75
USAGE_POLL_INTERVAL_MINUTES=30
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Frontend (cloudsense-frontend — when added)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your_google_client_id>.apps.googleusercontent.com
